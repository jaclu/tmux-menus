{
  "plugins": {
    "line-length": {
      "enabled": true,
      "line_length": 92,
      "code_block_line_length": 92,
      "tables": false
    },
    "no-inline-html": {
      "enabled": false
    },
    "commands-show-output": {
      "enabled": false
    },
    "table-column-style": {
      "enabled": false
    },
    "no-duplicate-heading": {
      "siblings_only": true
    }
  }
}
